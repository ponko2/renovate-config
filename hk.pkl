amends "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Builtins.pkl"

steps {
  ["editorconfig_checker"] = Builtins.editorconfig_checker
  ["jactionlint"] = Builtins.jactionlint
  ["mise"] = Builtins.mise
  ["oxfmt"] = Builtins.oxfmt
  ["renovate_config_validator"] {
    glob = "default.json"
    check = new CommandSpec {
      command = new Command {
        argv = List("pnpm", "exec", "renovate-config-validator", "--strict", "{{files}}")
      }
      effect = "read"
    }
  }
  ["ryl"] = Builtins.ryl
}

hooks {
  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = "commitlint --edit {{commit_msg_file}}"
      }
    }
  }
}
