amends "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  ["deadnix"] = Builtins.deadnix
  ["editorconfig_checker"] = (Builtins.editorconfig_checker) {
    check = new CommandSpec {
      command = new Command { argv = List("editorconfig-checker", "{{files}}") }
      effect = "read"
    }
  }
  ["nixfmt"] {
    glob = "**/*.nix"
    check = new CommandSpec {
      command = new Command { argv = List("nixfmt", "--check", "{{files}}") }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command { argv = List("nixfmt", "{{files}}") }
      effect = "write"
    }
  }
  ["oxfmt"] = Builtins.oxfmt
  ["renovate_config_validator"] {
    glob = "default.json"
    check = new CommandSpec {
      command = new Command {
        argv = List("pnpm", "exec", "renovate-config-validator", "--strict", "{{files}}")
      }
      effect = "read"
    }
  }
  ["statix"] {
    glob = "**/*.nix"
    check = new CommandSpec {
      command = new Command { argv = List("statix", "check") }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command { argv = List("statix", "fix") }
      effect = "write"
    }
  }
  ["yamllint"] = Builtins.yamllint
}

hooks {
  ["check"] {
    steps = linters
  }
  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = "commitlint --edit {{commit_msg_file}}"
      }
    }
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
}
