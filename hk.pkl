amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Builtins.pkl"

steps {
  ["deadnix"] = Builtins.deadnix
  ["editorconfig_checker"] = Builtins.editorconfig_checker
  ["nix_fmt"] = Builtins.nix_fmt
  ["oxfmt"] = Builtins.oxfmt
  ["renovate_config_validator"] {
    glob = "default.json"
    check = new CommandSpec {
      command = new Command {
        argv = List("pnpm", "exec", "renovate-config-validator", "--strict", "{{files}}")
      }
      effect = "read"
    }
  }
  ["statix"] {
    glob = "**/*.nix"
    check = new CommandSpec {
      command = new Command { argv = List("statix", "check") }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command { argv = List("statix", "fix") }
      effect = "write"
    }
  }
  ["yamllint"] = Builtins.yamllint
}

hooks {
  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = "commitlint --edit {{commit_msg_file}}"
      }
    }
  }
}
